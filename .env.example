# n8n-hubspot-deal-stage-regression-audit-logger
# DISCLAIMER.md · Licensed under the MIT License. License: MIT © 2026 dhRobin Systems · Provided as-is, see the disclaimer.
#
# Copy to .env for the CLI, or set the same variables in the n8n environment.
# Every value is a placeholder or a safe default. Never commit real values.

# --- HubSpot ---------------------------------------------------------------------
# Private app scopes: crm.objects.deals.read, crm.objects.owners.read, crm.objects.deals.write
# (owner tasks are associated with deals). While the token is a placeholder the workflow runs in
# demo mode: bundled fictional deals, no network calls.
HUBSPOT_PRIVATE_APP_TOKEN=YOUR_HUBSPOT_PRIVATE_APP_TOKEN
HUBSPOT_BASE_URL=https://api.hubapi.com
# Optional: a portal ID that SANDBOX_MODE accepts even if its account type is not SANDBOX/DEVELOPER_TEST.
HUBSPOT_SANDBOX_PORTAL_ID=YOUR_HUBSPOT_SANDBOX_PORTAL_ID

# --- Safety switches (fail safe: only false/0/no/off turns them off) -----------------
# DRY_RUN=true: detect and log to n8n static data only. No HubSpot tasks, no Airtable rows.
DRY_RUN=true
# SANDBOX_MODE=true: refuse production portals; Slack only to SLACK_SANDBOX_WEBHOOK_URL.
SANDBOX_MODE=true

# --- Webhook authentication -----------------------------------------------------------
# shared_secret: HubSpot workflow "Send a webhook" action with a secret header (recommended).
# hubspot_v3: HubSpot app webhook subscription, verified with X-HubSpot-Signature-v3.
WEBHOOK_AUTH_MODE=shared_secret
WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET
WEBHOOK_SECRET_HEADER=x-webhook-secret
HUBSPOT_APP_CLIENT_SECRET=YOUR_HUBSPOT_APP_CLIENT_SECRET
# The exact public https:// URL HubSpot calls (needed to verify v3 signatures).
WEBHOOK_PUBLIC_URL=YOUR_WEBHOOK_PUBLIC_URL
WEBHOOK_MAX_AGE_MINUTES=5
MAX_EVENTS_PER_REQUEST=100

# --- Regression detection -------------------------------------------------------------
# Comma-separated pipeline IDs to monitor (empty = all pipelines).
PIPELINE_IDS=
REGRESSION_MIN_STEPS=1
HIGH_SEVERITY_STEPS=2
TRACK_REOPENED_DEALS=true
TRACK_CLOSED_REVERSALS=true
# ignore | probability (a move to another pipeline counts only when win probability drops)
PIPELINE_CHANGE_POLICY=ignore

# --- Mandatory regression reason --------------------------------------------------------
REGRESSION_REASON_PROPERTY=deal_regression_reason
REASON_MIN_LENGTH=3
# Minutes to wait before a missing reason counts as missing (0 = check immediately).
REASON_GRACE_MINUTES=15
CREATE_OWNER_TASKS=true
TASK_DUE_HOURS=24

# --- Audit tracking table ----------------------------------------------------------------
# static: last rows in n8n workflow static data (no setup) | airtable: durable Airtable table
AUDIT_TABLE_PROVIDER=static
AIRTABLE_TOKEN=YOUR_AIRTABLE_PERSONAL_ACCESS_TOKEN
AIRTABLE_BASE_ID=YOUR_AIRTABLE_BASE_ID
AIRTABLE_TABLE_NAME=Deal Stage Regressions
AIRTABLE_BASE_URL=https://api.airtable.com
STATIC_AUDIT_ROW_LIMIT=200
INCLUDE_OWNER_EMAIL=false

# --- Leadership notification (Slack incoming webhooks) ---------------------------------------
SLACK_WEBHOOK_URL=YOUR_SLACK_WEBHOOK_URL
SLACK_SANDBOX_WEBHOOK_URL=YOUR_SLACK_SANDBOX_WEBHOOK_URL
# normal | high
ALERT_MIN_SEVERITY=normal
ALERT_ONLY_MISSING_REASON=false
ALERT_MIN_AMOUNT=0
ALERT_MAX_LISTED=10

# --- Manual runs in HubSpot mode --------------------------------------------------------------
MANUAL_TEST_DEAL_IDS=YOUR_SANDBOX_DEAL_IDS

# --- Testing only ------------------------------------------------------------------------------
# Pins the clock (ISO 8601). Leave empty in production.
AUDIT_NOW=

# --- n8n host settings (set on the n8n instance) ------------------------------------------------
# N8N_BLOCK_ENV_ACCESS_IN_NODE=false   lets Code nodes and expressions read $env
# NODE_FUNCTION_ALLOW_BUILTIN=crypto   lets the intake node verify signatures
